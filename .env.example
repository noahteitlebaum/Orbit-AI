# Copy this file to .env.local and fill in the values.
# Supabase → Project Settings → Data API (URL, without /rest/v1/) and API Keys (publishable key).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Waitlist: "on" (default) sends new accounts to /waitlist. "off" lets every verified @uwo.ca account in.
WAITLIST_MODE=on
# Comma-separated emails that skip the waitlist (team and testers).
EARLY_ACCESS_EMAILS=nteitleb@uwo.ca

# Server-only Supabase secret key (Project Settings → API Keys → Secret key). Used for budgets and image uploads.
# Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# "on" = real model calls with budget checks. Anything else = demo replies, no cost.
LIVE_MODELS=off
# Provider API keys (server only). A missing key shows "isn't set up yet" for that app.
OPENAI_API_KEY=
# Claude: ANTHROPIC_API_KEY or CLAUDE_API_KEY both work.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# Web search ("Search the web" in the + menu). Get a key at tavily.com. Without it, searching is turned off.
TAVILY_API_KEY=

# Spoken replies (voice conversations and "Listen"). Optional: with an ElevenLabs key, replies use ElevenLabs voices;
# without it they use OpenAI's voices (OPENAI_API_KEY); with neither, the browser's own voices.
ELEVENLABS_API_KEY=
# Optional default voice id (ElevenLabs → Voices → "ID"). Students can pick another in voice mode.
ELEVENLABS_VOICE_ID=

# Staff-only analytics page (/admin/analytics). Exact verified emails, comma separated, empty = no access.
ANALYTICS_ADMIN_EMAILS=
# Optional pgvector retrieval. Requires migration 0010, OpenAI key, and the student's memory opt-in.
SMART_MEMORY_ENABLED=off

# Integrations (+ menu → "Add from apps"). See docs/INTEGRATIONS.md. Apps without keys show as "not set up".
# GitHub, Zotero and YouTube need no keys (public repos; students paste their own Zotero key; Gemini watches videos).
# Google Drive — Google Cloud console: enable "Google Picker API" + "Google Drive API"; OAuth consent screen with the
# drive.file scope; an OAuth client (Web) with your site as an authorized JavaScript origin; an API key restricted to
# the Picker API and your site. APP_ID is the project number.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_PICKER_KEY=
NEXT_PUBLIC_GOOGLE_APP_ID=
# OneDrive — Microsoft Entra admin center → App registrations → New (accounts in any org + personal Microsoft accounts),
# platform "Single-page application" with redirect URI https://<your site>/auth/microsoft (and http://localhost:3000/auth/microsoft),
# API permission Microsoft Graph → delegated → Files.Read (+ Mail.Read, Calendars.Read for Outlook mail/calendar).
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
# Gmail / Google Calendar use NEXT_PUBLIC_GOOGLE_CLIENT_ID: add scopes gmail.readonly and calendar.readonly on the consent screen
# and enable the Gmail API + Google Calendar API.
# GitHub (private repos; public ones work without this) — github.com/settings/apps → New GitHub App: tick "Enable Device Flow",
# Repository permissions: Contents = Read-only, Metadata = Read-only; no webhook. Client ID + the app's URL slug:
NEXT_PUBLIC_GITHUB_CLIENT_ID=
NEXT_PUBLIC_GITHUB_APP_SLUG=
# Only for a classic OAuth App instead of a GitHub App (e.g. "repo"); leave empty for a GitHub App.
GITHUB_OAUTH_SCOPE=
# Notion — notion.so/profile/integrations → New integration → Public; capabilities: Read content only;
# redirect URI https://<your site>/auth/notion (and http://localhost:3000/auth/notion). The secret stays server-side.
NEXT_PUBLIC_NOTION_CLIENT_ID=
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=

# Orbit text-chat preview; requires migration 0014 and all four provider keys in live mode.
ORBIT_MODE_ENABLED=off
